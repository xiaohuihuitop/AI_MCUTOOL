	)
	(text "BAT_IN / EXT_IN → VSEL_P\nVOM1271T隔离栅极驱动\n共源背靠背N-MOS\n两路互斥、先断后通"
		(exclude_from_sim no)
		(at 325 61 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "2e1b8de2-22f7-582f-bc4a-86c37151c91c")
	)
	(text "DUT_UART：3.3V TTL\nTX三态缓冲，默认高阻\nRX施密特缓冲，持续接收\nTX / RX / GND三针接口"
		(exclude_from_sim no)
		(at 325 161 0)

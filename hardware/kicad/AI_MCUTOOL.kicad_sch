	(lib_symbols)
	(text "KEY1～KEY5独立无极性触点\nTLP176AM + MMBT3904\n按键边界：≤6V、≤20mA\n触点侧不接工具公共地"
		(exclude_from_sim no)
		(at 227 61 0)

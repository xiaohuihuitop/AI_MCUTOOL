{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCU TOOL",
  "version": "0.5.1",
  "identifier": "cn.mcutool.desktop",
  "build": {"frontendDist": "../loading"},
  "plugins": {"updater": {
    "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxQjcyRTFEQTNERUE5MjIKUldRaXFkNmpIUzYzVVc5N1NBOE9Da0dGTzZ2QUhyaHVYOUZtbVdFQkN5MlNYQTN2N0xKenVVL1UK",
    "endpoints": ["https://api.github.com/repos/xiaohuihuitop/AI_MCUTOOL/releases/latest"],
    "requireSignedVersion": true,
    "windows": {"installMode": "passive"}
  }},
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {"capabilities": ["main"], "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {"../runtime/": "runtime/"},
    "shortDescription": "MCU开发辅助工具桌面工作台",
    "windows": {
      "webviewInstallMode": {"type": "offlineInstaller", "silent": true},
      "nsis": {"installMode": "currentUser", "languages": ["SimpChinese"], "displayLanguageSelector": false,
               "startMenuFolder": "MCU TOOL", "installerHooks": "nsis/hooks.nsh"}
    }
  }
}
